{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipo-quality-score.example/schema/ipo-report.schema.json",
  "title": "IPO Quality Score Report",
  "description": "Evidence-first contract for a versioned IPO research report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "report_version",
    "methodology_version",
    "status",
    "issuer",
    "offering_state",
    "dimensions",
    "score_summary",
    "overall_confidence",
    "red_flags",
    "positive_signals",
    "evidence",
    "review"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "report_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "methodology_version": {
      "const": "0.1"
    },
    "status": {
      "enum": ["draft", "review", "published", "superseded", "withdrawn"]
    },
    "supersedes_report_id": {
      "type": ["string", "null"]
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "country", "industry"],
      "properties": {
        "legal_name": {"type": "string", "minLength": 1},
        "brand_name": {"type": ["string", "null"]},
        "country": {"type": "string", "minLength": 2},
        "industry": {"type": "string", "minLength": 1},
        "website": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "offering_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exchange",
        "ticker",
        "filing_type",
        "filing_version",
        "filing_published_at",
        "filing_url",
        "source_accessed_at"
      ],
      "properties": {
        "exchange": {"type": "string", "minLength": 1},
        "ticker": {"type": ["string", "null"]},
        "filing_type": {"type": "string", "minLength": 1},
        "filing_version": {"type": "string", "minLength": 1},
        "filing_published_at": {"type": "string", "format": "date-time"},
        "filing_url": {"type": "string", "format": "uri"},
        "source_accessed_at": {"type": "string", "format": "date-time"},
        "expected_offering_date": {"type": ["string", "null"], "format": "date"},
        "price_range_low": {"type": ["number", "null"], "minimum": 0},
        "price_range_high": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "primary_shares": {"type": ["integer", "null"], "minimum": 0},
        "secondary_shares": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/dimension"}
    },
    "score_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earned_points", "applicable_max_points", "normalized_score", "coverage_percent", "interpretation_band"],
      "properties": {
        "earned_points": {"type": "number", "minimum": 0, "maximum": 100},
        "applicable_max_points": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "normalized_score": {"type": "number", "minimum": 0, "maximum": 100},
        "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "interpretation_band": {"enum": ["strong_due_diligence_candidate", "meaningful_risks", "speculative_or_evidence_limited", "severe_concerns"]}
      }
    },
    "overall_confidence": {
      "enum": ["high", "medium", "low"]
    },
    "red_flags": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "positive_signals": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "contradictions": {
      "type": "array",
      "items": {"$ref": "#/$defs/contradiction"},
      "default": []
    },
    "unknowns": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "conflicts_of_interest": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "disclaimer": {
      "type": "string",
      "minLength": 100
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "publication_gate_passed"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "publication_gate_passed": {"type": "boolean"},
        "notes": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "max_points", "earned_points", "confidence", "evidence_ids", "judgment"],
      "properties": {
        "id": {
          "enum": [
            "revenue_durability",
            "profitability_cash_flow",
            "market_competition",
            "valuation_quality",
            "balance_sheet",
            "use_of_proceeds",
            "insiders_lockup_dilution",
            "governance_rights",
            "legal_regulatory",
            "disclosure_quality"
          ]
        },
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["scored", "unknown", "not_applicable", "blocked"]},
        "max_points": {"type": "number", "minimum": 0, "maximum": 15},
        "earned_points": {"type": ["number", "null"], "minimum": 0, "maximum": 15},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": []
        },
        "judgment": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "claim_id", "source_type", "source_title", "source_url", "published_at", "accessed_at", "location", "extracted_fact", "confidence", "review_status"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["regulatory_filing", "audited_financials", "exchange_notice", "issuer_disclosure", "market_data", "independent_reporting", "other"]},
        "source_title": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "source_version": {"type": ["string", "null"]},
        "published_at": {"type": "string", "format": "date-time"},
        "accessed_at": {"type": "string", "format": "date-time"},
        "location": {"type": "string", "minLength": 1},
        "extracted_fact": {"type": "string", "minLength": 1},
        "unit": {"type": ["string", "null"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "review_status": {"enum": ["unverified", "verified", "rejected"]},
        "quality_flags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "severity", "evidence_ids", "explanation"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "evidence_ids", "resolution_status"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "resolution_status": {"enum": ["open", "resolved", "accepted_uncertainty"]},
        "resolution": {"type": ["string", "null"]}
      }
    }
  }
}
